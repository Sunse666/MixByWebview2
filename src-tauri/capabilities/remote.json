{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "Remote pages may forward shortcuts, report context menus and ask permissions",
  "local": false,
  "windows": [
    "main"
  ],
  "webviews": [
    "*"
  ],
  "remote": {
    "urls": [
      "https://*/*",
      "http://*/*",
      "https://*:*/*",
      "http://*:*/*",
      "file:///*"
    ]
  },
  "permissions": [
    "allow-shortcut",
    "allow-context-menu",
    "allow-permission-request"
  ]
}

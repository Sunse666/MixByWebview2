{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "Remote pages may forward shortcuts, report context menus and ask permissions",
  "local": false,
  "windows": ["*"],
  "webviews": [
    "*"
  ],
  "remote": {
    "urls": [
      "https://*/*",
      "http://*/*",
      "https://*:*/*",
      "http://*:*/*",
      "file:///*"
    ]
  },
  "permissions": [
    "allow-shortcut",
    "allow-tab-icon",
    "allow-page-failed",
    "allow-tab-scroll",
    "allow-url-type",
    "allow-url-key",
    "allow-context-menu",
    "allow-permission-request",
    "allow-snap"
  ]
}
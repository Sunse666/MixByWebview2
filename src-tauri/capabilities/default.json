{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Mix app pages: chrome UI and overlay",
  "windows": [
    "main"
  ],
  "webviews": [
    "*"
  ],
  "permissions": [
    "core:default",
    "allow-layout-get",
    "allow-window-control",
    "allow-window-drag",
    "allow-window-resize",
    "allow-tab-list",
    "allow-tab-select",
    "allow-tab-new",
    "allow-tab-close",
    "allow-tab-navigate",
    "allow-tab-nav",
    "allow-theme-get",
    "allow-theme-apply",
    "allow-theme-revert",
    "allow-overlay-open",
    "allow-overlay-close",
    "allow-paths-get",
    "allow-open-dir",
    "allow-ext-list",
    "allow-script-list",
    "allow-ui-log",
    "allow-zoom-get",
    "allow-zoom-step",
    "allow-tab-print",
    "allow-window-fullscreen",
    "allow-app-clear-data",
    "allow-window-new",
    "allow-history-list",
    "allow-history-clear",
    "allow-bookmark-list",
    "allow-bookmark-toggle",
    "allow-bookmark-remove",
    "allow-diag-export",
    "allow-app-info",
    "allow-app-quit",
    "allow-download-list",
    "allow-download-open-dir",
    "allow-shortcut",
    "allow-context-menu",
    "allow-menu-context-get",
    "allow-permission-request",
    "allow-permission-reply",
    "allow-snap",
    "allow-settings-get",
    "allow-settings-set",
    "allow-autostart-get",
    "allow-autostart-set"
  ]
}